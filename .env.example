# ==========================================
# Data Platform Demo — 环境变量配置模板
# 复制此文件为 .env 并修改为你自己的配置
# ==========================================

# ---- 数据库 ----
DATA_PLATFORM_DB_HOST=data-platform-db
DATA_PLATFORM_DB_PORT=5432
DATA_PLATFORM_DB_USER=admin
DATA_PLATFORM_DB_PASSWORD=changeme
DATA_PLATFORM_DB_NAME=data_platform

# ---- Kafka ----
KAFKA_BOOTSTRAP_SERVER=kafka:29092
KAFKA_TOPIC=events

# ---- Airflow ----
AIRFLOW_USER=airflow
AIRFLOW_PASSWORD=airflow

# ---- 可选: Ubuntu VM (PySpark 远端执行) ----
# VM_HOST=
# VM_PORT=2222
# VM_USER=
# VM_PASS=

# ---- 运行环境 ----
ENV=dev

# ---- LLM / OpenAI-compatible API ----
# 支持 DeepSeek、OpenAI 或其他兼容 API
LLM_API_KEY=your-api-key-here
LLM_API_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.3

# ---- AI/ML 组件 ----
# Milvus (向量数据库)
MILVUS_HOST=milvus
MILVUS_PORT=19530

# Embedding 后端选择
# local: sentence-transformers (离线, 384d, CPU)
# openai: OpenAI-compatible Embedding API (需 LLM_API_KEY)
EMBEDDING_BACKEND=local

# Embedding 模型 (仅 EMBEDDING_BACKEND=local 时使用)
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000

# FAISS 知识库
RAG_INDEX_PATH=rag_demo/knowledge_base/index.faiss
RAG_META_PATH=rag_demo/knowledge_base/metadata.json

# Feast 特征平台
FEAST_REPO_PATH=feast/feature_repo

# ---- Neo4j 图数据库 ----
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme123
