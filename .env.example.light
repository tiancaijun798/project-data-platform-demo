# ==========================================
# Data Platform Demo — 轻量模式环境变量
# ==========================================
# 复制此文件为 .env 并修改配置
# cp .env.example.light .env
# ==========================================

# ---- 数据库 ----
DATA_PLATFORM_DB_HOST=postgres
DATA_PLATFORM_DB_PORT=5432
DATA_PLATFORM_DB_USER=admin
DATA_PLATFORM_DB_PASSWORD=changeme
DATA_PLATFORM_DB_NAME=data_platform

# ---- PostgreSQL (Docker) ----
POSTGRES_USER=admin
POSTGRES_PASSWORD=changeme
POSTGRES_DB=data_platform

# ---- 运行环境 ----
ENV=dev

# ---- LLM / OpenAI-compatible API ----
# 支持 DeepSeek、OpenAI、或其他兼容 API
LLM_API_KEY=your-api-key-here
LLM_API_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ---- Embedding 后端 ----
# local: sentence-transformers (离线, 384d, CPU)
# openai: 通过 LLM_API_KEY 调用云端 embedding API
EMBEDDING_BACKEND=local

# ---- Milvus (向量数据库) ----
MILVUS_HOST=milvus
MILVUS_PORT=19530

# ---- Embedding 模型 (仅 local 后端) ----
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# ---- MLflow ----
MLFLOW_TRACKING_URI=http://localhost:5000

# ---- FAISS 知识库 ----
RAG_INDEX_PATH=rag_demo/knowledge_base/index.faiss
RAG_META_PATH=rag_demo/knowledge_base/metadata.json

# ---- Neo4j ----
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme123

# ---- Feast 特征平台 ----
FEAST_REPO_PATH=feast/feature_repo
